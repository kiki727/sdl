{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdl.dev/schema/1.0/sdl-1.0.schema.json",
  "title": "SDL Core 1.0 document",
  "description": "JSON Schema for SDL Core 1.0 documents. Core 1.0 inherits the YAML subset rules of Core 0.2 (enforced by sdl.yaml.subset) and extends them with flow, implementation and proposal documents. The envelope version always equals the Core version.",
  "type": "object",
  "required": ["sdl", "kind"],
  "properties": {
    "sdl": { "const": "1.0" },
    "kind": {
      "type": "string",
      "enum": ["project", "module", "interface", "types", "flow", "implementation", "proposal"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "project" } }, "required": ["kind"] },
      "then": {
        "required": ["project"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "project" },
          "project": { "$ref": "#/$defs/project" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "module" } }, "required": ["kind"] },
      "then": {
        "required": ["module"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "module" },
          "module": { "$ref": "#/$defs/module" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "interface" } }, "required": ["kind"] },
      "then": {
        "required": ["interface"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "interface" },
          "interface": { "$ref": "#/$defs/interface" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "types" } }, "required": ["kind"] },
      "then": {
        "required": ["types"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "types" },
          "types": { "$ref": "#/$defs/typesMapping" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "flow" } }, "required": ["kind"] },
      "then": {
        "required": ["flow"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "flow" },
          "flow": { "$ref": "#/$defs/flow" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "implementation" } }, "required": ["kind"] },
      "then": {
        "required": ["implementation"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "implementation" },
          "implementation": { "$ref": "#/$defs/implementation" }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "proposal" } }, "required": ["kind"] },
      "then": {
        "required": ["proposal"],
        "properties": {
          "sdl": { "const": "1.0" },
          "kind": { "const": "proposal" },
          "proposal": { "$ref": "#/$defs/proposal" }
        },
        "additionalProperties": false
      }
    }
  ],
  "$defs": {
    "snakeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pascalId": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "versionRange": {
      "type": "string",
      "pattern": "^(\\^|~|>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+( (\\^|~|>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+)*$"
    },
    "typeExpression": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:<>,|() ]+$",
      "$comment": "This pattern rejects obviously invalid characters only. Arity, union flattening, generic arguments and name resolution are checked by the semantic validator."
    },
    "mode": {
      "type": "string",
      "enum": ["structural", "declarative"]
    },
    "backendMode": {
      "type": "string",
      "enum": ["codegen", "execute"]
    },
    "importPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\:*?\"<>|]+\\.sdl\\.yaml$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      },
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:" } }
      ]
    },
    "projectImport": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/importPath" }
      }
    },
    "moduleImport": {
      "type": "object",
      "required": ["module"],
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "#/$defs/snakeId" }
      }
    },
    "packageImport": {
      "type": "object",
      "required": ["package", "version"],
      "additionalProperties": false,
      "properties": {
        "package": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/versionRange" }
      }
    },
    "projectImports": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectImport" },
      "uniqueItems": true
    },
    "moduleImports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/moduleImport" },
          { "$ref": "#/$defs/packageImport" }
        ]
      },
      "uniqueItems": true
    },
    "aliasDeclaration": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/version" },
        "type": { "$ref": "#/$defs/typeExpression" }
      }
    },
    "enumDeclaration": {
      "type": "object",
      "required": ["id", "enum"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/version" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/snakeId" },
          "uniqueItems": true
        }
      }
    },
    "compoundDeclaration": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/version" },
        "fields": { "$ref": "#/$defs/propertyMap" }
      }
    },
    "typeDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/compoundDeclaration" },
        { "$ref": "#/$defs/aliasDeclaration" },
        { "$ref": "#/$defs/enumDeclaration" }
      ]
    },
    "typesMapping": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/pascalId" },
      "additionalProperties": { "$ref": "#/$defs/typeDeclaration" }
    },
    "inferredType": {
      "type": "object",
      "required": ["origin", "type"],
      "additionalProperties": false,
      "properties": {
        "origin": { "const": "inferred" },
        "type": { "$ref": "#/$defs/typeExpression" },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "approved"]
        }
      }
    },
    "unresolvedType": {
      "type": "object",
      "required": ["origin", "reason"],
      "additionalProperties": false,
      "properties": {
        "origin": { "const": "unresolved" },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typeOrInference": {
      "oneOf": [
        { "$ref": "#/$defs/typeExpression" },
        { "$ref": "#/$defs/inferredType" },
        { "$ref": "#/$defs/unresolvedType" }
      ]
    },
    "propertyMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/snakeId" },
      "additionalProperties": { "$ref": "#/$defs/typeOrInference" }
    },
    "output": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/typeExpression" }
      }
    },
    "classDeclaration": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pascalId" },
        "properties": { "$ref": "#/$defs/propertyMap" }
      }
    },
    "functionDeclaration": {
      "type": "object",
      "required": ["id"],
      "anyOf": [
        { "required": ["output"] },
        { "required": ["outputs"] }
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "version": { "$ref": "#/$defs/version" },
        "input": { "$ref": "#/$defs/propertyMap" },
        "inputs": { "$ref": "#/$defs/propertyMap" },
        "output": { "$ref": "#/$defs/output" },
        "outputs": { "$ref": "#/$defs/output" }
      }
    },
    "methodDeclaration": {
      "type": "object",
      "required": ["id"],
      "anyOf": [
        { "required": ["output"] },
        { "required": ["outputs"] }
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "version": { "$ref": "#/$defs/version" },
        "input": { "$ref": "#/$defs/propertyMap" },
        "inputs": { "$ref": "#/$defs/propertyMap" },
        "output": { "$ref": "#/$defs/output" },
        "outputs": { "$ref": "#/$defs/output" }
      }
    },
    "interface": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/version" },
        "imports": { "$ref": "#/$defs/projectImports" },
        "invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/methodDeclaration" }
        }
      }
    },
    "interfaceReference": {
      "type": "object",
      "required": ["interface"],
      "additionalProperties": false,
      "properties": {
        "interface": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/versionRange" }
      }
    },
    "binding": {
      "type": "object",
      "required": ["interface", "implementation"],
      "additionalProperties": false,
      "properties": {
        "interface": { "$ref": "#/$defs/pascalId" },
        "version": { "$ref": "#/$defs/version" },
        "implementation": { "$ref": "#/$defs/snakeId" }
      }
    },
    "backendOptions": {
      "type": "object",
      "$comment": "Backend options are backend specific and deliberately unconstrained.",
      "additionalProperties": true
    },
    "backend": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/backendMode" },
        "options": { "$ref": "#/$defs/backendOptions" }
      }
    },
    "buildProfile": {
      "type": "object",
      "required": ["id", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "target": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/backendMode" },
        "bindings_override": {
          "type": "array",
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    },
    "forbiddenImport": {
      "type": "object",
      "required": ["from", "deny", "reason"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/snakeId" },
        "deny": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/snakeId" },
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden_imports": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbiddenImport" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disallow_breaking_changes": { "type": "boolean" },
        "require_migration_for_type_change": { "type": "boolean" },
        "forbidden_id_changes": { "type": "boolean" }
      }
    },
    "statePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "$comment": "A path into Flow State: a variable name, optionally followed by field accesses."
    },
    "mapping": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/snakeId" },
      "additionalProperties": { "$ref": "#/$defs/statePath" }
    },
    "outputMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/snakeId" },
      "additionalProperties": { "$ref": "#/$defs/statePath" }
    },
    "retryPolicy": {
      "type": "object",
      "required": ["attempts"],
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "backoff": { "type": "string", "enum": ["fixed", "linear", "exponential"] },
        "initial_interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "max_interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" }
      }
    },
    "onError": {
      "type": "string",
      "pattern": "^(fail|ignore|retry|goto [a-z][a-z0-9_]*)$",
      "$comment": "Error handling strategy: fail (default), ignore, retry, or goto <step_id>."
    },
    "flowStep": {
      "type": "object",
      "required": ["id", "call"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "call": { "type": "string", "minLength": 1 },
        "mapping": { "$ref": "#/$defs/mapping" },
        "output_map": { "$ref": "#/$defs/outputMap" },
        "condition": { "type": "string", "minLength": 1 },
        "on_error": { "$ref": "#/$defs/onError" },
        "retry": { "$ref": "#/$defs/retryPolicy" }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "version": { "$ref": "#/$defs/version" },
        "imports": { "$ref": "#/$defs/projectImports" },
        "invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": { "$ref": "#/$defs/propertyMap" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowStep" }
        },
        "outputs": { "$ref": "#/$defs/propertyMap" },
        "output_mapping": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/snakeId" },
          "additionalProperties": { "$ref": "#/$defs/statePath" }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["id", "version", "implements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "version": { "$ref": "#/$defs/version" },
        "implements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interfaceReference" }
        },
        "language": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["file", "symbol"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "patchAction": {
      "type": "string",
      "enum": ["add", "replace", "remove"]
    },
    "patch": {
      "type": "object",
      "required": ["target", "action"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "action": { "$ref": "#/$defs/patchAction" },
        "value": {}
      }
    },
    "proposal": {
      "type": "object",
      "required": ["id", "target_version", "patches"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target_version": { "$ref": "#/$defs/version" },
        "author": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "approve": {
          "type": "boolean",
          "$comment": "Specification section 8.5: the final acceptance is performed by an administrator who confirms approve: true."
        },
        "patches": {
          "type": "array",
          "items": { "$ref": "#/$defs/patch" }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "version": { "$ref": "#/$defs/version" },
        "mode": { "$ref": "#/$defs/mode" },
        "imports": { "$ref": "#/$defs/projectImports" },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeDeclaration" }
        },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/interface" }
        },
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/binding" }
        },
        "backend": { "$ref": "#/$defs/backend" },
        "builds": {
          "type": "array",
          "items": { "$ref": "#/$defs/buildProfile" }
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "module": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "mode": { "$ref": "#/$defs/mode" },
        "imports": { "$ref": "#/$defs/moduleImports" },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeDeclaration" }
        },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/interface" }
        },
        "classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/classDeclaration" }
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionDeclaration" }
        },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    }
  }
}
